# Auth handled by oauth2-proxy at the edge — frontend has no auth env vars.

# ── Dev (MSW mocks) ────────────────────────────────────────────
NEXT_PUBLIC_API_MOCKING=enabled

# Shell version label (FE v<x>) — inlined at build time przez Next.js.
# W prod ustawiany przez Dockerfile/GHA z github.ref_name (tag) albo sha.
# NEXT_PUBLIC_SHELL_VERSION=dev

# Opcjonalny prefix ścieżki dla deploymentów pod subpath (np. Forsped UAT).
# Puste = root deploy, czyli zachowanie domyślne dla istniejących środowisk.
# NEXT_PUBLIC_BASE_PATH=/idp-next-uat

# Opcjonalne — partial carve-out do lokalnego backendu IDP
# (patrz docs/backend-integration.md). Używane tylko po stronie
# Next dev servera w rewrites; NIE eksponowane do przeglądarki.
# IDP_BACKEND_URL=http://localhost:8000
# IDP_BASIC_BACKEND_URL=http://localhost:8010
# INTRASTAT_BACKEND_URL=http://localhost:8020
# INVOICE_SUPERVISOR_BACKEND_URL=http://localhost:8504

# ── Prod (za Caddy + oauth2-proxy) ─────────────────────────────
# NEXT_PUBLIC_API_MOCKING=disabled
# IDP_BACKEND_URL=http://idp-app                 # Docker DNS na sieci run_default
# IDP_BASIC_BACKEND_URL=http://idp-basic-app
# INTRASTAT_BACKEND_URL=http://intrastat-app
# INVOICE_SUPERVISOR_BACKEND_URL=http://invoice-supervisor-app:8504   # backend nasłuchuje na 8504, nie 80 — port wymagany
# IMAGE_TAG=v0.1.0                               # tag image'u w docker-compose.image.yml

# ── Cortex Admin (server-side access check) ────────────────────
# Server-side ONLY — NIE używamy NEXT_PUBLIC_, klucz nie może trafić do przeglądarki.
# Defence-in-depth: drugi sygnał uprawnień obok /user/me has_access (per-tenant whitelist).
# CORTEX_ADMIN_API_BASE_URL=http://cortex-admin
# CORTEX_ADMIN_API_KEY=<bearer-token>
# CORTEX_APP_CODE=idp
# DEV_USER_EMAIL=dev@cortex.local                # DEV ONLY (NODE_ENV !== "production"); brak efektu w prod
