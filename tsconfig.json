{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["dom", "dom.iterable", "es2023"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "baseUrl": ".",
    "paths": {
      "@cortex/ui": ["packages/@cortex/ui/src/index.ts"],
      "@cortex/ui/*": ["packages/@cortex/ui/src/*"],
      "@cortex/styles": ["packages/@cortex/styles/index.ts"],
      "@cortex/styles/*": ["packages/@cortex/styles/*"],
      "@cortex/api": ["packages/@cortex/api/src/index.ts"],
      "@cortex/api/*": ["packages/@cortex/api/src/*"],
      "@cortex/types": ["packages/@cortex/types/src/index.ts"],
      "@cortex/types/*": ["packages/@cortex/types/src/*"],
      "@cortex/utils": ["packages/@cortex/utils/src/index.ts"],
      "@cortex/utils/*": ["packages/@cortex/utils/src/*"],
      "@cortex/tile-sdk": ["packages/@cortex/tile-sdk/src/index.ts"],
      "@cortex/service": ["packages/@cortex/service/src/index.ts"],
      "@cortex/db": ["packages/@cortex/db/src/index.ts"],
      "@cortex/desk-core/*": ["packages/@cortex/desk-core/src/*"],
      "@cortex/desk-ui/components/*": ["packages/@cortex/desk-ui/src/components/*"],
      "@cortex/desk-ui/*": ["packages/@cortex/desk-ui/src/*"],
      "@cortex/desk-app/api/*": ["packages/@cortex/desk-app/src/api/*"],
      "@cortex/desk-app/strony/*": ["packages/@cortex/desk-app/src/strony/*"],
      "@/*": ["app/idp/*"]
    },
    "types": ["node", "vitest/globals", "@testing-library/jest-dom"]
  },
  "include": [
    "app/**/*.ts",
    "app/**/*.tsx",
    // `apps/**` doszło razem z Biurkiem. Nie chodzi o sam typecheck — chodzi o lint:
    // `parserOptions.project` w `.eslintrc.cjs` wskazuje ten plik, więc katalog poza
    // `include` nie daje ostrzeżeń, tylko błąd parsowania na każdym pliku. Efekt był
    // taki, że `apps/**` nie był lintowany w ogóle i nikt tego nie widział.
    "apps/**/*.ts",
    "apps/**/*.tsx",
    "packages/@cortex/**/*.ts",
    "packages/@cortex/**/*.tsx",
    "e2e/**/*.ts",
    "playwright.config.ts",
    "app/idp/.next/types/**/*.ts",
    "app/idp/next-env.d.ts"
  ],
  "exclude": ["node_modules", "**/dist", "**/.next", "**/.next-dev"]
}
