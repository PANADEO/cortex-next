{
  "name": "@cortex/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate --config drizzle.system-config.config.ts",
    "db:migrate": "drizzle-kit migrate --config drizzle.system-config.config.ts",
    "db:migrate:apply": "node scripts/migrate.mjs",
    "db:seed:tile-manifests": "node scripts/seed-tile-manifests.mjs",
    "db:seed": "node scripts/seed-system-config.mjs",
    "db:generate:ilustromat": "drizzle-kit generate --config drizzle.ilustromat.config.ts",
    "db:migrate:ilustromat": "drizzle-kit migrate --config drizzle.ilustromat.config.ts",
    "db:seed:ilustromat": "node scripts/seed-ilustromat.mjs",
    "db:seed:token-usage": "node scripts/seed-token-usage.mjs",
    "db:generate:geo-score-calculator": "drizzle-kit generate --config drizzle.geo-score-calculator.config.ts",
    "db:migrate:geo-score-calculator": "drizzle-kit migrate --config drizzle.geo-score-calculator.config.ts",
    "db:seed:geo-score-calculator": "node scripts/seed-geo-score-calculator.mjs",
    "db:generate:document-parser": "drizzle-kit generate --config drizzle.document-parser.config.ts",
    "db:migrate:document-parser": "drizzle-kit migrate --config drizzle.document-parser.config.ts",
    "db:generate:content-guru": "drizzle-kit generate --config drizzle.content-guru.config.ts",
    "db:migrate:content-guru": "drizzle-kit migrate --config drizzle.content-guru.config.ts",
    "db:generate:visual-guru": "drizzle-kit generate --config drizzle.visual-guru.config.ts",
    "db:migrate:visual-guru": "drizzle-kit migrate --config drizzle.visual-guru.config.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.36.0",
    "postgres": "^3.4.0"
  },
  "devDependencies": {
    "@cortex/tile-sdk": "workspace:*",
    "drizzle-kit": "^0.28.0"
  }
}
